---
import LINKS_HOME from "@/data/links_home.js"

import Link from "@/components/UI/Link.astro"
import RedesSociales from "@/components/RedesSociales.astro"
import BtnThemeToggle from "@/components/UI/BtnThemeToggle.astro"
---

<nav
  aria-label="Navegación principal"
  class="items-center sticky top-0 bg-transparent border-x border-b border-neutral-200 dark:border-neutral-800 w-full mx-auto lg:max-w-4xl md:max-w-3xl z-50 transition-colors duration-300"
  id="navbar"
>
  <div
    class="mx-auto h-auto flex justify-center md:justify-between items-center"
  >
    <ul
      role="list"
      class="flex items-center divide-x divide-neutral-200 dark:divide-neutral-800"
    >
      {
        LINKS_HOME.map(({ url, titulo, icon }) => (
          <li>
            <Link url={url} titulo={titulo} icon={icon} />
          </li>
        ))
      }
    </ul>
    <div class="flex md:ms-14 mx-3">
      <ul
        role="list"
        class="flex justify-between divide-x divide-neutral-200 dark:divide-neutral-800 items-center"
      >
        <RedesSociales />
        <li class="mx-2">
          <BtnThemeToggle />
        </li>
      </ul>
    </div>
  </div>
</nav>

<style is:global>
  :root {
    --nav-bg: rgba(255, 255, 255, 0.85);
  }

  [data-theme="dark"] {
    --nav-bg: rgba(23, 23, 23, 0.85);
  }
</style>

<style>
  @keyframes add-shadow {
    to {
      background: var(--nav-bg);
    }
  }

  #navbar {
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    animation: add-shadow linear both;
    animation-timeline: scroll();
    animation-range: 0 150px;
  }
</style>
