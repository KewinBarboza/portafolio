---
import { Image } from "astro:assets"
import EXPERIENCIA from "@/data/experiencia.js"

interface Props {
  showAll?: boolean
}

const { showAll = false } = Astro.props

import iut from "@/assets/logos-empresas/iut.png"
import sl from "@/assets/logos-empresas/sl.png"
import lockey from "@/assets/logos-empresas/lockey.png"
import bodyfitness from "@/assets/logos-empresas/bodyfitness.jpg"
import careandsafety from "@/assets/logos-empresas/careandsafety.png"

const logos = {
  iut,
  sl,
  lockey,
  bodyfitness,
  careandsafety
}

const slWork = EXPERIENCIA[0]
const { tiempo, proyectos, nombre, icono, cargo, lugar, stack } = EXPERIENCIA[1]

const shortExperiencia = [
  slWork,
  {
    nombre: nombre,
    cargo: cargo,
    icono: icono,
    tiempo: tiempo,
    proyectos: proyectos.slice(0, 2),
    lugar,
    stack
  }
]

const experienciaData = showAll ? EXPERIENCIA : shortExperiencia
---

<article class="border-t border-neutral-200 dark:border-neutral-800">
  <main class:list={[{ "mask-b-from-50% mask-b-to-100%": !showAll }]}>
    <ol class="relative">
      {
        experienciaData.map(
          (
            { nombre, icono, proyectos, tiempo, cargo, lugar, stack },
            index
          ) => (
            <>
              <li>
                <header class="flex flex-col md:flex-row w-full border-b border-neutral-200 dark:border-neutral-800">
                  <div class="w-full md:w-16 shrink-0 self-stretch flex items-center justify-center overflow-hidden border-b md:border-b-0 md:border-r border-neutral-200 dark:border-neutral-800 py-4 md:py-0">
                    <Image
                      src={logos[icono]}
                      alt={`${nombre} logo`}
                      class="size-12 object-contain"
                    />
                  </div>
                  <div class="flex flex-col md:flex-row justify-between items-stretch w-full">
                    <div class="md:border-r border-neutral-200 dark:border-neutral-800 flex flex-col justify-center flex-1 min-w-0">
                      <div class="flex flex-wrap items-end mb-1 p-4 md:p-5 gap-x-2">
                        <h3 class="text-lg md:text-xl font-semibold dark:text-white text-neutral-600">
                          {cargo}
                        </h3>
                        <span class="text-base text-foreground dark:text-neutral-400">
                          -
                        </span>
                        <p class="text-base text-neutral-600 dark:text-neutral-400">
                          {nombre}
                        </p>
                      </div>

                      <div class="flex flex-wrap items-center gap-x-1 border-t border-neutral-200 dark:border-neutral-800">
                        {stack.map((item) => (
                          <span class="inline-flex items-center p-2 font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 text-nowrap text-neutral-800 dark:text-neutral-300 align-middle text-xs">
                            • {item}
                          </span>
                        ))}
                      </div>
                    </div>
                    <div class="flex flex-col items-center justify-center text-center px-6 py-3 md:py-0 border-t md:border-t-0 border-neutral-200 dark:border-neutral-800 shrink-0">
                      <p class="italic text-xs text-neutral-800 dark:text-gray-300">
                        {lugar}
                      </p>
                      <time class="block mt-1 text-sm font-normal leading-none text-neutral-800 dark:text-neutral-200">
                        {tiempo}
                      </time>
                    </div>
                  </div>
                </header>
                <main>
                  {proyectos.map(({ titulo, año, className }) => (
                    <div
                      class:list={[
                        "flex flex-col md:grid grid-cols-4 border-b border-neutral-200 dark:border-neutral-800 px-4 md:px-6 py-4 md:py-0 gap-1 md:gap-0",
                        className
                      ]}
                    >
                      <div class="dark:text-white text-neutral-600 text-base font-medium items-center flex">
                        {año}
                      </div>
                      <p class="md:col-span-3 text-pretty text-neutral-800 dark:text-neutral-300 leading-7 *:font-medium *:text-neutral-800 dark:*:text-white text-base md:p-6">
                        <Fragment set:html={titulo} />
                      </p>
                    </div>
                  ))}
                </main>
              </li>
              {showAll && (
                <div
                  class:list={[
                    "pattern-divider",
                    index < experienciaData.length - 1
                      ? "border-b border-neutral-200 dark:border-neutral-800"
                      : ""
                  ]}
                />
              )}
            </>
          )
        )
      }
    </ol>
  </main>

  {
    !showAll && (
      <a
        href="/experiencia"
        class="text-neutral-800 dark:text-white hover:underline border-y border-neutral-200 dark:border-neutral-800 py-4 block text-center"
      >
        Ver más
      </a>
    )
  }
</article>
