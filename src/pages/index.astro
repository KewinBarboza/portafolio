---
import Layout from "@/layouts/Layout.astro"
import Section from "@/layouts/Section.astro"
import PERSONA from "@/data/persona.js"

import Header from "@/components/sections/Header.astro"
import Experiencia from "@/components/sections/Experiencia.astro"
import Proyectos from "@/components/sections/Proyectos.astro"
import Recomendaciones from "@/components/sections/Recomendaciones.astro"
import Title from "@/components/UI/Title.astro"
import Tecnologias from "@/components/sections/Tecnologias.astro"
import Trabajemos from "@/components/sections/Trabajemos.astro"
import Certificados from "@/components/sections/Certificados.astro"

const title = `Desarrollador Frontend Senior | ${PERSONA.nombre}`
const description = `Portafolio de ${PERSONA.nombre}, ${PERSONA.profesion} con +6 años de experiencia creando aplicaciones web de alto rendimiento usando React, Next.js y Astro.`

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: PERSONA.nombre,
    url: PERSONA.portafolio,
    image: new URL(PERSONA.og_image, PERSONA.portafolio).toString(),
    jobTitle: PERSONA.profesion,
    description: PERSONA.sobre_mi,
    address: {
      "@type": "PostalAddress",
      addressLocality: PERSONA.direccion,
      addressCountry: "VE"
    },
    email: PERSONA.correo,
    sameAs: [PERSONA.LinkedIn],
    alumniOf: PERSONA.educacion.map(({ universidad, titulo }: any) => ({
      "@type": "CollegeOrUniversity",
      name: universidad,
      department: titulo
    })),
    knowsAbout: PERSONA.tecnologias
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: `${PERSONA.nombre} - Portafolio Profesional`,
    url: PERSONA.portafolio,
    description,
    author: {
      "@type": "Person",
      name: PERSONA.nombre
    }
  }
]
---

<Layout
  title={title}
  description={description}
  canonical="/"
  structuredData={structuredData}
>
  <Header />

  <main class="px-4">
    <Section id="experiencia">
      <Title title="Experiencia" />
      <Experiencia />
    </Section>

    <Section id="proyectos">
      <Title title="Proyectos" />
      <Proyectos />
    </Section>

    <Section id="contacto">
      <Trabajemos />
    </Section>

    <Section id="tecnologias">
      <Tecnologias />
    </Section>

    <Section id="certificados">
      <Title title="Certificados" />
      <Certificados />
    </Section>

    <Section id="recomendaciones">
      <Title title="Recomendaciones" />
      <Recomendaciones />
    </Section>
  </main>
</Layout>
