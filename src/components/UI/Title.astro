---
interface Props {
  title: string
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6"
}

const { title, as: Tag = "h2" } = Astro.props
---

<Tag
  class="font-bold font-sans border-t border-neutral-200 dark:border-neutral-800 px-6 text-transparent text-pretty h-full text-4xl md:text-5xl lg:text-6xl py-2 bg-clip-text bg-gradient-to-br from-primary to-primary/30 dark:from-secondary dark:to-secondary/30"
>
  {title}
</Tag>
