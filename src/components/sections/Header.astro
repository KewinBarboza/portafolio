---
import { Image } from "astro:assets"
import PERSONA from "@/data/persona.js"
import ButtonPrimary from "@/components/UI/ButtonPrimary.astro"
import foto from "../../../public/image/foto2026p.png"
import { BtnDownloadCv } from "@/components/react/btn-download-cv"

const { nombre, profesion, curriculum, proyectos, carrera } = PERSONA
---

<header
  id="inicio"
  class="scroll-mt-24 w-full mx-auto lg:max-w-4xl md:max-w-3xl border-b border-x border-neutral-200 dark:border-neutral-800"
>
  <div class="max-w-6xl mx-auto">
    <div
      class="grid md:grid-cols-5 gap-8 md:gap-12 lg:gap-15 items-center pt-12 ps-6"
    >
      <div class="text-center md:text-start col-span-3">
        <div class="mb-5 flex gap-2 flex-wrap justify-center md:justify-start">
          <span
            class="inline-flex items-center justify-center rounded-full custom-shadow px-3 py-1 text-base md:text-lg font-medium backdrop-blur-3xl"
          >
            <span
              class="bg-gradient-to-t bg-clip-text text-transparent from-neutral-950 via-gray-600 to-gray-400 dark:from-primary/30 dark:via-white dark:to-white"
            >
              {carrera}
            </span>
          </span>

          <span
            class="inline-flex items-center justify-center rounded-full custom-shadow px-3 py-1 text-base md:text-lg font-medium backdrop-blur-3xl"
          >
            <span
              class="bg-gradient-to-t bg-clip-text text-transparent from-neutral-950 via-gray-600 to-gray-400 dark:from-primary/30 dark:via-white dark:to-white"
            >
              +{proyectos} Proyectos
            </span>
          </span>
        </div>
        <h1 class="sr-only">
          {nombre} - {profesion} Portfolio
        </h1>
        <div
          aria-hidden="true"
          class="flex items-center justify-center md:justify-start font-bold animate-text-gradient mb-2 text-transparent text-4xl sm:text-5xl md:text-5xl lg:text-6xl bg-clip-text bg-gradient-to-br from-primary to-primary/30 dark:from-secondary dark:to-secondary/30"
        >
          {nombre}
        </div>
        <p
          class="text-pretty font-normal text-neutral-800 dark:text-white leading-7 text-lg md:text-xl"
        >
          {profesion} con <strong class="font-semibold"
            >+6 años de experiencia</strong
          > trabando para grandes empresas
        </p>

        <div class="mt-8 md:mt-10 w-full text-center md:text-start">
          <BtnDownloadCv client:only="react">
            <ButtonPrimary
              slot="fallback"
              title="Descargar CV"
              href={curriculum}
              target="_blank"
            />
          </BtnDownloadCv>
        </div>
      </div>
      <div
        class="flex justify-center items-center w-full h-full col-span-3 md:col-span-2 mask-b-from-20% mask-b-to-95%"
      >
        <Image
          class="object-cover aspect-[4/5] w-full max-w-[280px] md:max-w-[375px]"
          src={foto}
          alt={`${nombre} desarrollador FrontEnd`}
          width={375}
          height={375}
        />
      </div>
    </div>
  </div>
</header>
