---
import EXPERIENCIA from "@/data/experiencia.js"
import PERSONA from "@/data/persona.js"

import Layout from "@/layouts/Layout.astro"
import Title from "@/components/UI/Title.astro"
import Trabajemos from "@/components/sections/Trabajemos.astro"
import ExperienciaSection from "@/components/sections/Experiencia.astro"

const customDescription = `Conoce mi trayectoria profesional y experiencia laboral como ${PERSONA.profesion}. Exploración de proyectos, tecnologías y empresas donde he aportado mi talento.`

const structuredData = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  mainEntity: {
    "@type": "Person",
    name: PERSONA.nombre,
    jobTitle: PERSONA.profesion,
    description: customDescription,
    url: PERSONA.portafolio,
    sameAs: [PERSONA.LinkedIn],
    alumniOf: PERSONA.educacion.map((edu: any) => ({
      "@type": "CollegeOrUniversity",
      name: edu.universidad
    })),
    worksFor: EXPERIENCIA.map((exp: any) => ({
      "@type": "Organization",
      name: exp.nombre
    }))
  }
}
---

<Layout
  title={`Experiencia Laboral y Profesional | ${PERSONA.nombre} | ${PERSONA.profesion}`}
  description={customDescription}
  structuredData={structuredData}
>
  <div
    class="w-full mx-auto md:px-0 border-x border-x-neutral-200 dark:border-x-neutral-800 lg:max-w-4xl md:max-w-3xl"
  >
    <a
      href="/#proyectos"
      class="text-neutral-800 px-3 dark:text-white hover:underline py-4 block text-start"
      >← Volver atrás</a
    >
    <header>
      <Title title="Experiencia" as="h1" />
    </header>
    <main class="mt-5">
      <ExperienciaSection showAll={true} />

      <Trabajemos />

      <div class="pattern-divider"></div>
    </main>
  </div>
</Layout>
