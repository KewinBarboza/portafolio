---
import { Image } from "astro:assets"
import RECOMENDACIONES from "@/data/recomendaciones.js"

import alexander from "@/assets/image/alexander.webp"
import romulo from "@/assets/image/romulo.webp"
import camilo from "@/assets/image/camilo.webp"
import carlos from "@/assets/image/carlos.webp"

const foto = {
  alexander,
  romulo,
  camilo,
  carlos
}
---

<article
  class="grid grid-cols-1 md:grid-cols-2 border-t border-neutral-200 dark:border-neutral-800"
>
  {
    RECOMENDACIONES.map(({ nombre, empresa, descripcion, cargo, image }) => (
      <article class="flex flex-col justify-between p-7 border-b border-neutral-200 dark:border-neutral-800 md:[&:nth-child(even)]:border-l">
        <main class="flex-auto mb-3">
          <p class="font-base text-base text-pretty text-neutral-800 dark:text-white mb-0">
            {descripcion}
          </p>
        </main>
        <footer class="flex items-start mt-2 gap-x-4">
          {image === "" ? (
            <div class="aspect-[5/4] object-cover size-10 bg-neutral-200 dark:bg-neutral-800 rounded-full" />
          ) : (
            <Image
              src={foto[image]}
              class="aspect-[5/4] object-cover size-10 rounded-full"
              loading="lazy"
              decoding="async"
              height="36"
              width="36"
              alt={nombre}
            />
          )}

          <div class="w-full flex flex-col items-start">
            <p class="font-semibold text-neutral-800 dark:text-neutral-200 text-sm">
              {nombre}
            </p>
            <p class="mb-4 font-normal text-neutral-800 dark:text-neutral-400 text-sm ">
              {cargo}
            </p>
            <p class="dark:text-neutral-600 text-neutral-600 text-sm block">
              {empresa}
            </p>
          </div>
        </footer>
      </article>
    ))
  }
</article>
