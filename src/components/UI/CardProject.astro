---
import { Image } from "astro:assets"
import type { ImageMetadata } from "astro"

export const prerender = true

interface Props {
  slug: string
  imagen: string
  nombre: string
  descripcion: string
  gradient: string
}

const { slug, imagen, nombre, descripcion, gradient } = Astro.props

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/img-projects/*.{jpeg,jpg,png,gif,avif,webp}"
)

const imagePath = `/src/assets/${imagen}`
---

<a
  href={slug}
  class="group relative rounded-xl overflow-hidden p-6 flex flex-col justify-between transition-shadow"
>
  <span class="sr-only">Ver proyecto {nombre}</span>
  <header
    class={`${gradient} group-hover:opacity-30 transition-opacity flex justify-center items-stretch rounded-xl overflow-hidden h-52`}
  >
    <Image
      transition:name={`cover-project-${slug}`}
      src={images[imagePath]()}
      class="object-cover transition duration-500 sm:h-full md:scale-110 md:group-hover:scale-100"
      decoding="async"
      alt={`Vista previa del proyecto ${nombre}`}
    />
  </header>
  <main class="flex-auto min-w-full">
    <h3
      class="dark:text-white text-neutral-800 text-xl font-medium mb-1"
      transition:name={`title-project-${nombre}`}
      transition:animate="fade"
    >
      {nombre}
    </h3>
    <p
      class="text-neutral-800 dark:text-neutral-300 leading-7 text-md text-pretty"
    >
      {descripcion}
    </p>
  </main>
</a>
