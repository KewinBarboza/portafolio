---
interface Props {
  title: string
  href: string
  target?: "_parent" | "_blank"
}

const { title, href, target } = Astro.props
---

<a
  type="button"
  class="text-gray-100 dark:text-black bg-black dark:bg-white dark:hover:bg-neutral-100 hover:bg-gray-950 focus:ring-4 focus:outline-none focus:ring-white font-medium border border-neutral-200 dark:border-neutral-800 text-sm px-5 py-2.5 text-center inline-flex items-center dark:focus:ring-gray-500 me-2 mb-2 rounded-lg"
  href={href}
  target={target}
>
  {title}
</a>
