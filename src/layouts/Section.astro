---
export interface Props {
  id: string
}

const { id } = Astro.props
---

<section
  class="scroll-mt-14 w-full border-x mx-auto lg:max-w-4xl md:max-w-3xl border-neutral-200 dark:border-neutral-800 bg-white dark:bg-black"
  id={id}
>
  <div class="pattern-divider"></div>
  <slot />
  <div class="pattern-divider"></div>
</section>
