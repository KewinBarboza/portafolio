---
import Image from "astro/components/Image.astro"
import PROYECTOS from "@/data/proyectos.js"
import PERSONA from "@/data/persona.js"

import Layout from "@/layouts/Layout.astro"
import { IconName } from "@/icons/mapIcons"

import Icons from "@/components/Icons.astro"
import CardProject from "@/components/UI/CardProject.astro"
import Trabajemos from "@/components/sections/Trabajemos.astro"

export async function getStaticPaths() {
  return PROYECTOS.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry }
  }))
}

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/img-projects/*.{jpeg,jpg,png,gif,avif,webp}"
)

const { entry } = Astro.props

const imagePath = `/src/assets/${entry.imagen.srcPoster}`

if (!images[imagePath])
  throw new Error(
    `"${imagePath}" does not exist in glob: "src/assets/*.{jpeg,jpg,png,gif,avif,webp}"`
  )

const orderRandom = [...PROYECTOS].sort(() => Math.random() - 0.5)
const project = orderRandom.splice(0, 2)

const title = `${entry.nombre} - Proyecto Frontend | ${PERSONA.nombre}`
const description = `${entry.descripcion}. Descubre cómo desarrollé este proyecto usando ${entry.lenguajes.slice(0, 3).join(", ")}.`
const url = new URL(`/project/${entry.slug}`, PERSONA.portafolio).toString()

const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: entry.nombre,
  description: entry.descripcion,
  applicationCategory: "WebApplication",
  operatingSystem: "Web",
  author: {
    "@type": "Person",
    name: PERSONA.nombre,
    url: PERSONA.portafolio
  },
  url: entry.url || url,
  image: new URL(
    imagePath.replace("/src/assets/", "/"),
    PERSONA.portafolio
  ).toString(),
  offers: {
    "@type": "Offer",
    price: "0"
  },
  keywords: entry.lenguajes.join(", ")
}
---

<Layout
  title={title}
  description={description}
  canonical={`/project/${entry.slug}`}
  structuredData={structuredData}
>
  <div
    class="w-full mx-auto md:px-0 border-x border-x-neutral-200 dark:border-x-neutral-800 lg:max-w-4xl md:max-w-3xl"
  >
    <a
      href="/#proyectos"
      class="text-neutral-800 px-3 dark:text-white hover:underline border-b border-neutral-200 dark:border-neutral-800 py-4 block text-start"
      >← Volver atrás</a
    >
    <header>
      <div class="my-10 px-6">
        <h1
          class="dark:text-secondary text-primary font-medium mb-3 text-pretty text-4xl sm:text-5xl md:text-5xl lg:text-6xl"
          transition:name={`title-project-${entry.slug}`}
          transition:animate="fade"
        >
          {entry.nombre}
        </h1>
        <h2
          class="text-neutral-800 dark:text-neutral-300 leading-7 text-lg text-pretty mb-2"
        >
          {entry.descripcion}
        </h2>
      </div>
      <div class="md:col-span-3 overflow-hidden px-6">
        <Image
          class="w-full aspect-video object-cover"
          src={images[imagePath]()}
          width={1200}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          format="avif"
          alt={`Captura de pantalla o vista previa del proyecto ${entry.nombre}: ${entry.descripcion}`}
        />
      </div>
    </header>

    <main class="mt-5">
      <p
        class="text-neutral-800 dark:text-neutral-300 text-lg mt-7 text-pretty leading-7 px-6 border-b border-neutral-200 dark:border-neutral-800 pb-6"
      >
        {entry.post}
      </p>
      <div class="pattern-divider"></div>
      <section class="border-t border-neutral-200 dark:border-neutral-800">
        <h2
          class="dark:text-white text-neutral-800 font-semibold text-2xl my-5 px-6"
        >
          Tecnologías utilizadas
        </h2>

        <ul
          class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 border-y border-neutral-200 dark:border-neutral-800"
        >
          {
            (() => {
              const total = entry.lenguajes.length
              const lastRowStart1 = total - 1
              const lastRowStart2 = total - (total % 2 || 2)
              const lastRowStart3 = total - (total % 3 || 3)

              return entry.lenguajes.map((lenguaje: string, index: number) => (
                <li
                  class:list={[
                    "text-center flex flex-col overflow-hidden items-center p-4 dark:text-white text-neutral-800 border-neutral-200 dark:border-neutral-800",
                    index % 2 !== 0 ? "sm:border-l" : "",
                    index % 3 !== 0 ? "lg:border-l" : "lg:border-l-0",
                    index < lastRowStart1 ? "border-b" : "",
                    index < lastRowStart2 ? "sm:border-b" : "sm:border-b-0",
                    index < lastRowStart3 ? "lg:border-b" : "lg:border-b-0"
                  ]}
                >
                  <Icons name={lenguaje as IconName} size={24} />
                  <span class="text-center mt-2 text-sm">{lenguaje}</span>
                </li>
              ))
            })()
          }
        </ul>
      </section>

      <div class="pattern-divider"></div>
      <section class="border-t border-neutral-200 dark:border-neutral-800">
        <h2
          class="dark:text-white text-neutral-800 font-semibold text-2xl my-5 px-6"
        >
          Enlaces del proyecto
        </h2>

        <div
          class="p-6 border-y border-neutral-200 dark:border-neutral-800 space-y-4"
        >
          <a
            target="_blank"
            rel="noopener noreferrer"
            class="flex w-fit flex-wrap items-center gap-1 ext-neutral-800 dark:text-neutral-300 leading-7 underline underline-offset-4 hover:text-foreground hover:no-underline font-semibold"
            href={entry.url}>Visitar sitio web del proyecto →</a
          >

          {
            !entry.isPrivate && (
              <a
                target="_blank"
                rel="noopener noreferrer"
                class="flex w-fit flex-wrap items-center gap-1 ext-neutral-800 dark:text-neutral-300 leading-7 underline underline-offset-4 hover:text-foreground hover:no-underline font-semibold"
                href={entry.url_repositorio}
              >
                Ver código fuente en GitHub →
              </a>
            )
          }
        </div>
      </section>
    </main>

    <div class="pattern-divider"></div>
    <section class="border-t border-neutral-200 dark:border-neutral-800">
      <h2
        class="dark:text-white text-neutral-800 font-semibold text-2xl my-5 px-6"
      >
        Otros proyectos creados
      </h2>
      <div
        class="grid grid-cols-1 md:grid-cols-2 border-y border-neutral-200 dark:border-neutral-800"
      >
        {
          project.map(
            (
              { nombre, imagen, descripcion, slug, gradient }: any,
              index: number
            ) => (
              <div
                class:list={[
                  "border-neutral-200 dark:border-neutral-800",
                  index % 1 !== 0 ? "border-l" : "",
                  index % 2 !== 0 ? "md:border-l" : "md:border-l-0",
                  index >= 1 ? "border-t" : "",
                  index >= 2 ? "md:border-t" : "md:border-t-0"
                ]}
              >
                <CardProject
                  slug={`${slug}`}
                  nombre={nombre}
                  imagen={imagen.srcPoster}
                  descripcion={descripcion}
                  gradient={gradient}
                />
              </div>
            )
          )
        }
      </div>
    </section>
    <div class="pattern-divider"></div>
    <footer>
      <Trabajemos />
    </footer>
    <div class="pattern-divider"></div>
  </div>
</Layout>
