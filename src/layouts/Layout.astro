---
import { ClientRouter } from "astro:transitions"
import "@/styles/global.css"

import { Font } from "astro:assets"

import PERSONA from "@/data/persona.js"
import Footer from "@/components/sections/Footer.astro"
import Navbar from "@/components/UI/Navbar.astro"
export interface Props {
  title: string
  description?: string
  canonical?: string
  robots?: string
  ogType?: string
  ogImage?: string
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>
  lang?: string
}

const {
  title,
  description = PERSONA.sobre_mi,
  canonical,
  robots = "index, follow",
  ogType = "website",
  ogImage = PERSONA.og_image,
  structuredData,
  lang = "es"
} = Astro.props as Props

const canonicalSource = canonical ?? Astro.url.pathname
const absoluteCanonical = new URL(
  canonicalSource,
  PERSONA.portafolio
).toString()
const absoluteOgImage = new URL(ogImage, PERSONA.portafolio).toString()
---

<html lang={lang} class="scroll-smooth" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="google-site-verification"
      content="rnxUFqz2VUuGVXj1AfgABfHG1zgzQ3R5j1Jz1zaXtq0"
    />

    <meta name="description" content={description} />
    <meta name="author" content={PERSONA.nombre} />
    <meta name="robots" content={robots} />
    <meta
      name="keywords"
      content={PERSONA.tecnologias.join(", ") +
        ", " +
        PERSONA.carrera +
        ", " +
        PERSONA.nombre}
    />
    <link rel="canonical" href={absoluteCanonical} />

    <meta property="og:url" content={absoluteCanonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={PERSONA.nombre} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@kewinbarboza" />
    <meta name="twitter:creator" content="@kewinbarboza" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{title}</title>
    {
      structuredData && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(structuredData)}
        />
      )
    }

    <script src="/darkMode.js" is:inline async></script>

    <ClientRouter />
    <Font cssVariable="--font-geist" preload />
  </head>

  <body class="dark:bg-black bg-secondary overflow-x-hidden relative">
    <Navbar />
    <slot />
    <Footer />
  </body>
</html>

<style is:global>
  .custom-shadow {
    box-shadow:
      inset 0 0 0 1px hsla(0, 0%, 100%, 0.12),
      0 0 0 1px rgba(0, 0, 0, 0.04);
  }
</style>

<style is:global>
  .pattern-divider {
    height: 6rem;
    width: 100%;
    --pattern-fg: color-mix(in oklab, #000 10%, transparent);
    background: repeating-linear-gradient(
      315deg,
      var(--pattern-fg) 0,
      var(--pattern-fg) 1px,
      transparent 0,
      transparent 50%
    );
    background-size: 10px 10px;
  }

  [data-theme="dark"] .pattern-divider {
    --pattern-fg: color-mix(in oklab, #fff 10%, transparent);
  }
</style>
