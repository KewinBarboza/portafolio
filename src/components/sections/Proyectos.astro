---
import { Image } from "astro:assets"
import type { ImageMetadata } from "astro"
import PROYECTOS from "@/data/proyectos.js"
import { IconName } from "@/icons/mapIcons"
import Icons from "@/components/Icons.astro"

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/project-screenshots/*.webp"
)
---

<ul
  class="grid grid-cols-1 sm:grid-cols-3 divide-y sm:divide-y-0 sm:divide-x divide-neutral-200 dark:divide-neutral-800 border-y border-neutral-200 dark:border-neutral-800"
>
  {
    PROYECTOS.map((project) => {
      const imagePath = `/src/assets/${project.imagen.src}`
      return (
        <li class="flex">
          <a
            href={`/project/${project.slug}`}
            class="group overflow-hidden transition-shadow flex flex-col w-full"
          >
            <span class="sr-only">
              Ver detalles del proyecto {project.nombre}
            </span>
            <article class="flex flex-col h-full">
              <main class="p-4 sm:p-6 flex-1">
                <h3
                  class="text-lg sm:text-xl font-bold text-neutral-800 dark:text-white"
                  transition:name={`title-project-${project.slug}`}
                  transition:animate="fade"
                >
                  {project.nombre}
                </h3>
                <p class="mt-1 text-pretty text-neutral-600 dark:text-neutral-400 leading-6 text-sm sm:text-base font-normal">
                  {project.descripcion}
                </p>

                <ul class="flex flex-wrap gap-2 mt-4">
                  {project.lenguajes.map((lenguaje: any) => (
                    <li
                      class="flex items-center justify-center w-8 h-8 rounded-full border border-neutral-300 dark:border-neutral-700 grayscale group-hover:grayscale-0 duration-300 ease-in-out transition-all dark:text-white text-slate-600"
                      title={lenguaje}
                    >
                      <Icons name={lenguaje as IconName} size={16} />
                    </li>
                  ))}
                </ul>
              </main>

              <div class="mt-auto">
                <div class="px-4 sm:px-6">
                  <div class="rounded-lg overflow-hidden w-full h-[160px]">
                    {images[imagePath] && (
                      <Image
                        class="object-cover w-full h-full transition-all duration-500 ease-out group-hover:scale-105 [mask-image:linear-gradient(to_bottom,black_60%,transparent_100%)] [mask-repeat:no-repeat] [mask-size:100%_100%]"
                        src={images[imagePath]()}
                        transition:name={`cover-project-${project.slug}`}
                        alt={`Vista previa del proyecto ${project.nombre}`}
                      />
                    )}
                  </div>
                </div>
                <div class="border-b border-neutral-200 dark:border-neutral-800 mt-4 sm:mt-6" />
              </div>
            </article>
          </a>
        </li>
      )
    })
  }
</ul>
